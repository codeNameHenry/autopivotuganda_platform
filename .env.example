# =============================================================================
# AutoPivot Uganda - Environment Configuration
# =============================================================================

# APPLICATION
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# DATABASE - PostgreSQL
DATABASE_URL=postgresql://autopivot:password@localhost:5432/autopivot_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# REDIS
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ELASTICSEARCH
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# TIMESCALEDB
TIMESCALEDB_URL=postgresql://autopivot:password@localhost:5432/autopivot_timeseries

# AUTHENTICATION
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1
REFRESH_TOKEN_EXPIRATION_DAYS=30

# AWS
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=autopivot-images
AWS_S3_URL=https://autopivot-images.s3.eu-west-2.amazonaws.com

# PAYMENT GATEWAYS
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_xxx

# EXTERNAL SERVICES
MAPBOX_ACCESS_TOKEN=pk_test_xxx
GOOGLE_MAPS_API_KEY=xxx
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx

# ML/AI
ML_MODEL_PATH=/models/pivot_score_v1
ML_SERVE_PORT=8500
ML_BATCH_SIZE=32

# EMAIL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@autopivot.ug

# LOGGING
LOG_LEVEL=INFO
LOG_FORMAT=json

# SERVICE PORTS
LISTING_SERVICE_PORT=8001
ADVANTAGE_ENGINE_PORT=8002
LOGISTICS_SERVICE_PORT=8003
CHAT_SERVICE_PORT=8004
USER_SERVICE_PORT=8005
VERIFICATION_SERVICE_PORT=8006
PAYMENT_SERVICE_PORT=8007
API_GATEWAY_PORT=8000

# FEATURE FLAGS
ENABLE_AR_INSPECTION=false
ENABLE_INSURANCE_INTEGRATION=false
ENABLE_FINANCING_INTEGRATION=false
ENABLE_ADMIN_DASHBOARD=false

# RATE LIMITING
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# SECURITY
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1,autopivot.ug,www.autopivot.ug
